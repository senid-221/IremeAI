# Server-only AI credentials. Never prefix these with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint override:
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Server runtime
PORT=8787
NODE_ENV=development
# Optional: set to the exact deployed frontend origin when using cross-origin requests.
# CORS_ORIGIN=https://your-domain.example
AI_RATE_LIMIT_PER_MINUTE=20

# Optional future education data service
# DATABASE_URL=
