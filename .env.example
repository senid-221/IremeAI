# Server-only AI credentials. Never prefix these with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional live web research (Exa). Add the key in the hosting provider's server environment.
# Without this key, the tutor uses only its configured model and any database context.
EXA_API_KEY=
# Optional OpenAI-compatible endpoint override:
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Server runtime
PORT=8787
NODE_ENV=development
# Optional: set to the exact deployed frontend origin when using cross-origin requests.
# CORS_ORIGIN=https://your-domain.example
AI_RATE_LIMIT_PER_MINUTE=20
# Generate a random secret of at least 32 bytes; required to enable account sessions.
SESSION_SECRET=

# PostgreSQL connection string. Required to enable accounts and database-backed sessions.
# DATABASE_URL=

# Temporary protected hPanel education setup page; use a unique secret of at least 32 characters.
EDUCATION_SETUP_TOKEN=

# Temporary hPanel-only setup page secret: generate a unique random value of 32+ characters.
# Add this only to Hostinger server environment variables; never commit the real secret.
EDUCATION_SETUP_SECRET=
